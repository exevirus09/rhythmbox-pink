# This is the build file for project "rhythmbox"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = cc $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && gcc-ar $LINK_ARGS $out $in
 description = Linking static target $out

rule c_LINKER
 command = cc $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule SHSYM
 command = /usr/bin/meson --internal symbolextractor /home/h4ydi/.u/rhythmbox2/_build $in $IMPLIB $out $CROSS
 description = Generating symbol file $out
 restat = 1

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule CUSTOM_COMMAND_DEP
 command = $COMMAND
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /usr/bin/meson --internal regenerate /home/h4ydi/.u/rhythmbox2 .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

# Build rules for targets

build data/org.gnome.Rhythmbox3.desktop: CUSTOM_COMMAND ../data/org.gnome.Rhythmbox3.desktop.in
 COMMAND = /usr/bin/meson --internal msgfmthelper --msgfmt=/usr/bin/msgfmt ../data/org.gnome.Rhythmbox3.desktop.in data/org.gnome.Rhythmbox3.desktop desktop /home/h4ydi/.u/rhythmbox2/po
 description = Merging$ translations$ for$ data/org.gnome.Rhythmbox3.desktop

build data/org.gnome.Rhythmbox3.device.desktop: CUSTOM_COMMAND ../data/org.gnome.Rhythmbox3.device.desktop.in
 COMMAND = /usr/bin/meson --internal msgfmthelper --msgfmt=/usr/bin/msgfmt ../data/org.gnome.Rhythmbox3.device.desktop.in data/org.gnome.Rhythmbox3.device.desktop desktop /home/h4ydi/.u/rhythmbox2/po
 description = Merging$ translations$ for$ data/org.gnome.Rhythmbox3.device.desktop

build data/gschemas.compiled: CUSTOM_COMMAND ../data/org.gnome.rhythmbox.gschema.xml | /usr/bin/glib-compile-schemas
 COMMAND = /usr/bin/glib-compile-schemas --targetdir=/home/h4ydi/.u/rhythmbox2/_build/data /home/h4ydi/.u/rhythmbox2/data
 description = Generating$ data/gschemas.compiled$ with$ a$ custom$ command

build data/playlists.xml: CUSTOM_COMMAND ../data/playlists.xml.in
 COMMAND = /usr/bin/meson --internal msgfmthelper --msgfmt=/usr/bin/msgfmt --datadirs=/home/h4ydi/.u/rhythmbox2/data ../data/playlists.xml.in data/playlists.xml xml /home/h4ydi/.u/rhythmbox2/po
 description = Merging$ translations$ for$ data/playlists.xml

build data/org.gnome.Rhythmbox3.metainfo.xml: CUSTOM_COMMAND ../data/org.gnome.Rhythmbox3.metainfo.xml.in
 COMMAND = /usr/bin/meson --internal msgfmthelper --msgfmt=/usr/bin/msgfmt ../data/org.gnome.Rhythmbox3.metainfo.xml.in data/org.gnome.Rhythmbox3.metainfo.xml xml /home/h4ydi/.u/rhythmbox2/po
 description = Merging$ translations$ for$ data/org.gnome.Rhythmbox3.metainfo.xml

