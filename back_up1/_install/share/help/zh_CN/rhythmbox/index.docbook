   <abstract role="description">
     <para>Rhythmbox 是 GNOME 桌面的全功能音乐播放器。</para>
   </abstract>

  </articleinfo> 


  <indexterm zone="index" lang="en">
    <primary>Rhythmbox</primary>
  </indexterm>
